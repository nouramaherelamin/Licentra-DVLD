# ==============================================================================
# Licentra Root Environment Configuration Example
# Copy this file to .env or configure in respective frontend/backend directories
# ==============================================================================

# Backend Port
PORT=5000

# Client Application URL (for CORS in backend)
CLIENT_URL=http://localhost:5173

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Database Configuration (Postponed - for future Supabase / PostgreSQL integration)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
